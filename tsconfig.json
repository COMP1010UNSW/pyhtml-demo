{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"./vite.config.ts",
		"./vitest.config.ts",
		"./svelte.config.js",
		"./eslint.config.mjs",
		"./src/**/*.js",
		"./src/**/*.ts",
		"./src/**/*.svelte",
		"./src/routes/.well-known/**/*.ts"
	]
}
